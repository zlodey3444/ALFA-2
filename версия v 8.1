void handleSetSystemMode() {
if (server.hasArg("step")) {
int requestedStep = server.arg("step").toInt();
if (requestedStep >= (int)WELCOME && requestedStep < (int)AVARIA_STOP) {
if (currentStep == LAB_POWER_SUPPLY_RUN || currentStep == SMART_CHARGER_SCREEN) sendCommandToPowerSupply(0.0);
resetOperatorActivityTimer();
changeSystemStep((Step)requestedStep);
if (currentStep == LAB_POWER_SUPPLY_RUN) sendCommandToPowerSupply(activeProfile.targetVoltage);
else if (currentStep == SMART_CHARGER_SCREEN) { activeProfile.chargerModeActive = true; sendCommandToPowerSupply(activeProfile.chargerEndVoltage); }
server.sendHeader("Access-Control-Allow-Origin", "*");
server.send(200, "application/json", "{"status":"ok","current_step":" + String(requestedStep) + "}");
return;
}
}
server.send(400, "application/json", "{"status":"error"}");
}
void calculateAndStabilizeAutonomousCompressor() {
unsigned long currentMillis = millis();
if (currentMillis - lastTachoMillis >= 1000) {
noInterrupts(); unsigned long pulses = compressorPulseCount; compressorPulseCount = 0; interrupts();
unsigned long timeElapsed = currentMillis - lastTachoMillis; lastTachoMillis = currentMillis;
currentCompressorRPM = (int)((pulses * 60000.0) / (PULSES_PER_REVOLUTION * timeElapsed));
}
currentCompressorPressure = (analogRead(PIN_COMPRESSOR_AIR_SENSOR) / 4095.0) * 100.0;
if (currentCompressorPressure > maxCompressorPressureLimit) {
if (!compressorAlarmTriggered) { compressorAlarmTriggered = true; compressorPWMDuty = 0; ledcWrite(PWM_COMPRESSOR_CHANNEL, 0); }
if (millis() - compBuzzerTimer >= 500) { compBuzzerTimer = millis(); static bool bState = false; bState = !bState; digitalWrite(PIN_BUZZER, bState ? HIGH : LOW); }
} else {
if (compressorAlarmTriggered && currentCompressorPressure < (maxCompressorPressureLimit - 2.0)) { compressorAlarmTriggered = false; digitalWrite(PIN_BUZZER, LOW); }
}
if (currentMillis - lastCompPIDMillis >= 200) {
float dt = (currentMillis - lastCompPIDMillis) / 1000.0; lastCompPIDMillis = currentMillis;
if (activeProfile.compressorEnabled && !networkAlarmTriggered && !compressorAlarmTriggered) {
float error = targetCompressorPressure - currentCompressorPressure;
integral_comp += error * dt; integral_comp = constrain(integral_comp, -40.0, 40.0);
float derivative = (error - last_error_comp) / dt; last_error_comp = error;
float output = (error * kp_comp) + (integral_comp * ki_comp) + (derivative * kd_comp);
compressorPWMDuty = constrain((int)output, 0, (activeProfile.maxCompressorPct * 255) / 100);
ledcWrite(PWM_COMPRESSOR_CHANNEL, compressorPWMDuty);
} else if (!activeProfile.compressorEnabled || networkAlarmTriggered) {
compressorPWMDuty = 0; integral_comp = 0; last_error_comp = 0; ledcWrite(PWM_COMPRESSOR_CHANNEL, 0);
}
}
if (currentMillis - graphUpdateTimer >= 1000) {
graphUpdateTimer = currentMillis;
for (int i = 0; i < COMP_GRAPH_WIDTH - 1; i++) historyCompressorPressure[i] = historyCompressorPressure[i + 1];
int scaledPressure = map(constrain((int)currentCompressorPressure, 0, 100), 0, 100, 0, 150);
historyCompressorPressure[COMP_GRAPH_WIDTH - 1] = (uint8_t)scaledPressure;
}
}
