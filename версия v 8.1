void loadProfileFromEEPROM() { 
  activeProfile.targetVoltage = 12.0; activeProfile.maxCurrentLimit = 5.0; activeProfile.chargerEndVoltage = 14.4; activeProfile.chargerMaxCurrent = 2.5; activeProfile.startCaseFanT = 30.0; 
  activeProfile.startTimerEnabled = true; activeProfile.startHour = 7; activeProfile.startMinute = 30; 
  activeProfile.stopTimerEnabled = true; activeProfile.stopHour = 22; activeProfile.stopMinute = 0;   
  activeProfile.maxCompressorPct = 80; activeProfile.compressorEnabled = false;
  
  EEPROM.get(EEPROM_ADDR_COMP_TARGET, targetCompressorPressure);
  EEPROM.get(EEPROM_ADDR_COMP_LIMIT, maxCompressorPressureLimit);
  if (isnan(targetCompressorPressure) || targetCompressorPressure < 0 || targetCompressorPressure > 100) targetCompressorPressure = 15.0;
  if (isnan(maxCompressorPressureLimit) || maxCompressorPressureLimit < 10 || maxCompressorPressureLimit > 100) maxCompressorPressureLimit = 55.0;
}

void sendCommandToPowerSupply(float voltage) { Serial2.print("VOUT:"); Serial2.println(voltage, 1); }

void triggerPureTone(int mode) {
  if (mode == 1) { tone(PIN_BUZZER, 2500, 80); delay(100); tone(PIN_BUZZER, 2500, 80); }
  else if (mode == 2) { tone(PIN_BUZZER, 1300, 100); delay(40); tone(PIN_BUZZER, 700, 100); } 
  else if (mode == 3) { tone(PIN_BUZZER, 400, 50); }
}
void beepClick() { tone(PIN_BUZZER, 2000, 40); }

void handleCombinedButtonLed() {
  unsigned long currentMillis = millis();
  if (currentStep == HARDWARE_SLEEP_WAIT) { rgbLed.setPixelColor(0, rgbLed.Color(0, 150, 0)); rgbLed.show(); return; }
  if (isButtonHeldForShutdown) { int pulse = map(sin(currentMillis / 50.0) * 100, -100, 100, 50, 255); rgbLed.setPixelColor(0, rgbLed.Color(pulse, 0, pulse)); rgbLed.show(); return; }
  if (currentStep == AVARIA_STOP || networkAlarmTriggered) { static bool toggle = false; if (currentMillis - ledSignalTimer >= 80) { ledSignalTimer = currentMillis; toggle = !toggle; if (toggle) rgbLed.setPixelColor(0, rgbLed.Color(255, 0, 0)); else rgbLed.setPixelColor(0, rgbLed.Color(0, 0, 0)); rgbLed.show(); } return; }
  rgbLed.setPixelColor(0, rgbLed.Color(0, 40, 0)); rgbLed.show();
}

