for (int i = 0; i < GRAPH_WIDTH - 1; i++) { historyNetVoltage[i] = historyNetVoltage[i+1]; historyNetCurrent[i] = historyNetCurrent[i+1]; historyNetworkPower[i] = historyNetworkPower[i+1]; }
historyNetVoltage[GRAPH_WIDTH-1] = map(constrain((int)netVoltageRMS, 150, 280), 150, 280, 0, 180); historyNetCurrent[GRAPH_WIDTH-1] = map(constrain((int)(netCurrentRMS * 10), 0, 160), 0, 160, 0, 180); historyNetworkPower[GRAPH_WIDTH-1] = map(constrain((int)netPowerWatts, 0, 3500), 0, 3500, 0, 180);
}
if (networkAlarmTriggered && isScreenTouched) { if (touchX >= 180 && touchX <= 620 && touchY >= 130 && touchY <= 350) { networkAlarmTriggered = false; menuNeedsRedraw = true; delay(300); } }
encoderDirection = 0; int currentCLKState = digitalRead(PIN_ENC_CLK);
