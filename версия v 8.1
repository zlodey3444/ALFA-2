// Нативный встроенный класс-драйвер тач-панели FT6336 через Wire
class NativeP4Touch {
private:
  const uint8_t FT6336_ADDR = 0x38;
  int _x = 0;
  int _y = 0;
public:
  bool begin() {
    Wire.beginTransmission(FT6336_ADDR);
    return (Wire.endTransmission() == 0);
  }
  bool touched() {
    Wire.beginTransmission(FT6336_ADDR);
    Wire.write(0x02); // Регистр количества касаний
    Wire.endTransmission();
    Wire.requestFrom(FT6336_ADDR, (uint8_t)1);
    if (Wire.available() && Wire.read() > 0) {
      Wire.beginTransmission(FT6336_ADDR);
      Wire.write(0x03); // Старший регистр координаты X
      if (Wire.endTransmission() == 0) {
        Wire.requestFrom(FT6336_ADDR, (uint8_t)4);
        if (Wire.available() >= 4) {
          uint8_t x_msb = Wire.read(); uint8_t x_lsb = Wire.read();
          uint8_t y_msb = Wire.read(); uint8_t y_lsb = Wire.read();
          _x = ((x_msb & 0x0F) << 8) | x_lsb;
          _y = ((y_msb & 0x0F) << 8) | y_lsb;
          _x = map(_x, 0, 480, 0, 800);
          _y = map(_y, 0, 800, 0, 480);
          return true;
        }
      }
    }
    return false;
  }
  int getX() { return _x; }
  int getY() { return _y; }
};
