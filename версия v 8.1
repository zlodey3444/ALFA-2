if (menuNeedsRedraw || (millis() - displayTimer >= 500)) {
displayTimer = millis(); if (menuNeedsRedraw) dpiTft.fillScreen(T_BLACK); menuNeedsRedraw = false;
dpiTft.fillRect(0, 0, 800, 45, T_CYAN); dpiTft.setTextSize(2); dpiTft.setTextColor(T_BLACK); dpiTft.setCursor(20, 15); tft_print_rus("⚙️ УПРАВЛЕНИЕ АВТОНОМНЫМ АППАРАТОМ-КОМПРЕССОРОМ");
dpiTft.drawFastVLine(395, 40, 440, T_GRAY);
uint32_t colPress = (subMenuItem == 0) ? T_YELLOW : T_DARK_CARD; uint32_t colState = (subMenuItem == 1) ? T_YELLOW : T_DARK_CARD; uint32_t colAlarm = (subMenuItem == 2) ? T_YELLOW : T_DARK_CARD;
dpiTft.fillRoundRect(20, 60, 360, 65, 8, colPress); if(subMenuItem == 0) dpiTft.drawRoundRect(20, 60, 360, 65, 8, T_WHITE); dpiTft.setTextColor(subMenuItem == 0 ? T_BLACK : T_WHITE); dpiTft.setTextSize(2); dpiTft.setCursor(35, 83); dpiTft.printf("УСТАВКА P: %.1f kPa", targetCompressorPressure);
dpiTft.fillRoundRect(20, 140, 360, 65, 8, colState); if(subMenuItem == 1) dpiTft.drawRoundRect(20, 140, 360, 65, 8, T_WHITE); dpiTft.setTextColor(subMenuItem == 1 ? T_BLACK : T_WHITE); dpiTft.setCursor(35, 163); tft_print_rus("СТАТУС: "); if(activeProfile.compressorEnabled) tft_print_rus("АКТИВЕН"); else tft_print_rus("ВЫКЛЮЧЕН");
dpiTft.fillRoundRect(20, 220, 360, 65, 8, colAlarm); if(subMenuItem == 2) dpiTft.drawRoundRect(20, 220, 360, 65, 8, T_WHITE); dpiTft.setTextColor(subMenuItem == 2 ? T_BLACK : T_RED); dpiTft.setCursor(35, 243); dpiTft.printf("ЛИМИТ АВАРИИ: %.1f", maxCompressorPressureLimit);
dpiTft.setTextSize(2); dpiTft.setTextColor(T_WHITE); dpiTft.setCursor(20, 310); dpiTft.printf("Давление: %.2f kPa", currentCompressorPressure); dpiTft.setCursor(20, 345); dpiTft.printf("Обороты: %d RPM", currentCompressorRPM); dpiTft.setCursor(20, 380); dpiTft.printf("ШИМ Мощность: %d%%", map(compressorPWMDuty, 0, 255, 0, 100));
dpiTft.fillRoundRect(20, 420, 260, 40, 8, T_GRAY); dpiTft.setTextColor(T_WHITE); dpiTft.setCursor(55, 432); tft_print_rus("[ В ГЛАВНОЕ МЕНЮ ]");
dpiTft.setTextSize(2); dpiTft.setTextColor(T_CYAN); dpiTft.setCursor(415, 60); tft_print_rus("ГРАФИК СТАБИЛИЗАЦИИ ДАВЛЕНИЯ");
int graphBaseY = 380; dpiTft.fillRect(410, 95, COMP_GRAPH_WIDTH, 290, T_BLACK);
dpiTft.drawFastHLine(410, graphBaseY, COMP_GRAPH_WIDTH, T_GRAY); dpiTft.drawFastHLine(410, graphBaseY - 75, COMP_GRAPH_WIDTH, 0x111111); dpiTft.drawFastHLine(410, graphBaseY - 150, COMP_GRAPH_WIDTH, T_GRAY);
dpiTft.setTextSize(1); dpiTft.setTextColor(T_GRAY); dpiTft.setCursor(415, graphBaseY - 12);  tft_print_rus("0 kPa"); dpiTft.setCursor(415, graphBaseY - 162); tft_print_rus("100 kPa");
int targetY = graphBaseY - map((int)targetCompressorPressure, 0, 100, 0, 150); for (int x = 410; x < 410 + COMP_GRAPH_WIDTH; x += 8) dpiTft.drawFastHLine(x, targetY, 4, T_MAGENTA);
int alarmY = graphBaseY - map((int)maxCompressorPressureLimit, 0, 100, 0, 150); dpiTft.drawFastHLine(410, alarmY, COMP_GRAPH_WIDTH, T_RED);
for (int i = 0; i < COMP_GRAPH_WIDTH - 1; i++) { int x1 = 410 + i; int x2 = 410 + i + 1; int y1 = graphBaseY - historyCompressorPressure[i]; int y2 = graphBaseY - historyCompressorPressure[i + 1]; y1 = constrain(y1, 95, graphBaseY); y2 = constrain(y2, 95, graphBaseY); dpiTft.drawLine(x1, y1, x2, y2, T_CYAN); }
} return;
}
if (currentStep != HARDWARE_SLEEP_WAIT && currentStep != WELCOME && currentStep != RTC_CLOCK_SCREEN) {
bool isColumnRunning    = (currentStep == GLOBAL_MONITORING_SCREEN && digitalRead(PIN_HEATER) == HIGH);
bool isLbaRunning       = (currentStep == LAB_POWER_SUPPLY_RUN && !isPaused && liveCurrentAmperes > 0.05);
bool isChargerRunning   = (currentStep == SMART_CHARGER_SCREEN && activeProfile.chargerModeActive);
bool isCompressorActive = (activeProfile.compressorEnabled && compressorPWMDuty > 30);
if (!isColumnRunning && !isLbaRunning && !isChargerRunning && !isCompressorActive) {
if (millis() - lastOperatorActivityMillis >= OPERATOR_TIMEOUT_MS) { subMenuItem = 0; infoSettingsCursor = 0; changeSystemStep(RTC_CLOCK_SCREEN); resetOperatorActivityTimer(); }
} else { resetOperatorActivityTimer(); }
}
}
